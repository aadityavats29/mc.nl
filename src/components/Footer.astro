---
import Monogram from './Monogram.astro';
import { waLinkFor } from '../lib/pub';

interface Props {
  site: any;
  navData: any;
}
const { site, navData } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-cols">
      <div class="footer-brand">
        <Monogram label="" />
        <span class="brand-name">Maison Coiffure</span>
        <p style="margin-top: 12px; font-size: 0.9375rem; color: var(--muted); max-width: 30ch;">
          {navData?.footerAbout ?? ''}
        </p>
      </div>

      <div>
        <h4>Visit</h4>
        <address>
          {site.addressLine}<br />
          {site.availability}.<br />
          {site.walkIns}
        </address>
      </div>

      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href={waLinkFor(site, 'Hello Maison Coiffure, I would like to make an appointment.')} rel="noopener">WhatsApp for an appointment</a></li>
          <li><a href={`tel:${site.phoneIntl}`}>{site.phoneDisplay}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.instagram} rel="noopener">Instagram</a></li>
        </ul>
      </div>

      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href="/treatments">Treatments</a></li>
          <li><a href="/treatments/salon-party">Salon Party</a></li>
          <li><a href="/for-businesses/corporate-salon">Corporate Salon</a></li>
          <li><a href="/for-businesses/care-homes">Care Homes</a></li>
          <li><a href="/gallery">Gallery</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-meta">
      <span>© {year} {site.name}, {site.locality}</span>
      <span>{navData?.footerNote ?? 'By appointment only'}</span>
    </div>
  </div>
</footer>
