---
import { nav } from '../data/site';
import Monogram from './Monogram.astro';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
function current(href?: string) {
  if (!href) return false;
  return href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
}
const chev =
  '<svg class="chev" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" fill="none"><path d="M1.5 3.5 5 7l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Maison Coiffure home">
      <Monogram label="" />
      <span class="brand-name">Maison Coiffure</span>
    </a>

    <nav class="primary-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => {
            if (item.children && item.href) {
              /* Treatments: direct catalogue link plus a labelled disclosure */
              return (
                <li class="nav-group">
                  <a href={item.href} class="line-link" aria-current={current(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                  <button
                    type="button"
                    class="disclosure-btn"
                    aria-expanded="false"
                    aria-label={`Open ${item.label} menu`}
                    set:html={chev}
                  />
                  <div class="dropdown">
                    <ul>
                      {item.children.map((c) => (
                        <li>
                          <a href={c.href} aria-current={current(c.href) ? 'page' : undefined}>
                            {c.label}
                            {c.note && <span class="dd-note">{c.note}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              );
            }
            if (item.children) {
              return (
                <li class="nav-group">
                  <button type="button" aria-expanded="false">
                    {item.label} <Fragment set:html={chev} />
                  </button>
                  <div class="dropdown">
                    <ul>
                      {item.children.map((c) => (
                        <li>
                          <a href={c.href} aria-current={current(c.href) ? 'page' : undefined}>
                            {c.label}
                            {c.note && <span class="dd-note">{c.note}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              );
            }
            return (
              <li>
                <a href={item.href} class="line-link" aria-current={current(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header-book">
      <a class="btn btn-primary" href="/book">Book an appointment</a>
    </div>

    <a class="btn btn-primary compact-book" href="/book">Book</a>
    <button type="button" class="menu-btn" id="menu-open" aria-haspopup="dialog" aria-controls="menu-drawer">
      Menu
      <svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true" fill="none">
        <path d="M1 1h14M1 6h14M1 11h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</header>
