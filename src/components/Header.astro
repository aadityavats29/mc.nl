---
/**
 * Minimal header per the 14 September Navy-led update: small MC mark at the
 * left, Menu at the right with a discreet booking action. Compact navigation
 * is the default at every width; the complete MC sitemap lives in the drawer.
 * On the homepage the header sits transparently over the hero and gains a
 * solid MC surface after it (180ms transition, handled in motion.js).
 */
import Monogram from './Monogram.astro';

interface Props {
  overHero?: boolean;
  site: any;
  navData: any;
}
const { overHero = false, navData } = Astro.props;
const items = navData?.items ?? [];
---

<header class={`site-header${overHero ? ' over-hero' : ''}`}>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Maison Coiffure home">
      <Monogram label="" />
      <span class="brand-name">Maison Coiffure</span>
    </a>

    <a class="btn compact-book" href="/book">Book</a>
    <button type="button" class="menu-btn" id="menu-open" aria-haspopup="dialog" aria-controls="menu-drawer">
      Menu
      <svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true" fill="none">
        <path d="M1 1h14M1 6h14M1 11h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</header>

<noscript>
  <nav class="nojs-nav" aria-label="Main">
    <div class="wrap">
      <ul>
        {
          items.map((item: any) => (
            <Fragment>
              {item.href && (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              )}
              {item.children?.map((c: any) => (
                <li>
                  <a href={c.href}>{c.label}</a>
                </li>
              ))}
            </Fragment>
          ))
        }
        <li><a href="/book"><strong>Book an appointment</strong></a></li>
      </ul>
    </div>
  </nav>
</noscript>
