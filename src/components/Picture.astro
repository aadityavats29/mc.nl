---
import type { McImage } from '../data/images';
import { srcset, src } from '../data/images';

interface Props {
  image: McImage;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
  class?: string;
  /** Explicit intrinsic dimensions keep layout stable before load. */
}
const {
  image,
  sizes = '(max-width: 767px) 100vw, 50vw',
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className,
} = Astro.props;
---

<img
  src={src(image, 1200)}
  srcset={srcset(image)}
  sizes={sizes}
  alt={image.alt}
  width={image.w}
  height={image.h}
  loading={loading}
  decoding={loading === 'eager' ? 'sync' : 'async'}
  fetchpriority={fetchpriority}
  class={className}
/>
