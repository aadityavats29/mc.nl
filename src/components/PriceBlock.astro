---
import { priceLabel } from '../data/services';

interface Props {
  group: any; // shared service-group record content
  headingLevel?: 'h2' | 'h3';
  conditionText?: string; // shared global price condition (settings:booking)
}
const { group, headingLevel = 'h3', conditionText } = Astro.props;
const H = headingLevel;
const hasDurations = group.options.some((o: any) => o.duration);
const showCondition = (group.globalCondition ?? group.showGlobalCondition) && conditionText;
---

<div class="price-block" id={group.id}>
  <H>{group.title}</H>
  {group.sharedCopy && <p class="shared-copy">{group.sharedCopy}</p>}

  <table class="price-table">
    <thead class="sr-only">
      <tr>
        <th scope="col">Service</th>
        <th scope="col" class="copy-cell">Description</th>
        <th scope="col">Price</th>
        {hasDurations && <th scope="col" class="h-dur">Duration</th>}
      </tr>
    </thead>
    <tbody>
      {
        group.options.map((o: any) => (
          <tr>
            <td class="svc">{o.name}</td>
            <td class="copy copy-cell">{o.copy}</td>
            <td class="price">{priceLabel(o)}</td>
            {hasDurations && <td class="dur">{o.duration ?? ''}</td>}
          </tr>
        ))
      }
    </tbody>
  </table>

  {group.notes && group.notes.map((n: string) => <p class="note-box plain" style="margin-block: 1rem 0;">{n}</p>)}
  {showCondition && <p class="note-box" style="margin-block: 1.2rem 0;">{conditionText}</p>}
</div>
