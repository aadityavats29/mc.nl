---
/**
 * Shared structure for treatment detail pages: title and short introduction,
 * relevant MC image, explanation, current options with correct price
 * semantics, practical notes and a clear next step. FAQs may supplement but
 * never replace the core description.
 */
import Base from '../layouts/Base.astro';
import PageHead from './PageHead.astro';
import Picture from './Picture.astro';
import type { McImage } from '../data/images';
import { site, waLink } from '../data/site';

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  lede: string;
  image?: McImage;
  /** Primary action; defaults to booking via WhatsApp */
  ctaLabel?: string;
  ctaHref?: string;
  waMessage?: string;
}
const {
  title,
  metaTitle,
  description,
  lede,
  image,
  ctaLabel = 'Book an appointment',
  ctaHref,
  waMessage = `Hello Maison Coiffure, I would like to book: ${title}.`,
} = Astro.props;
const cta = ctaHref ?? waLink(waMessage);
---

<Base title={metaTitle ?? title} description={description}>
  <PageHead
    eyebrow="Treatments"
    title={title}
    lede={lede}
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Treatments', href: '/treatments' },
      { label: title },
    ]}
  />

  <div class="wrap section">
    <div class="split" style="align-items: start;">
      <article class="prose">
        <slot />
      </article>
      <div>
        {image && (
          <div class="photo-frame" style="aspect-ratio: 4 / 5;">
            <Picture image={image} sizes="(max-width: 767px) 100vw, 45vw" />
          </div>
        )}
        <div class="note-box" style="margin-top: 20px;">
          <h4>Ready when you are</h4>
          <p>
            {site.availability}. Booking works simply via WhatsApp; we confirm the details together.
          </p>
          <p style="margin-top: 12px;">
            <a class="btn btn-primary" href={cta} rel="noopener">{ctaLabel}</a>
          </p>
        </div>
      </div>
    </div>

    <slot name="after" />
  </div>
</Base>
