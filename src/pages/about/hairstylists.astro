---
/**
 * The stylist directory. With one active stylist the full profile is shown
 * directly; when several real stylists exist, a portrait list links to
 * individual profiles at /about/hairstylists/<slug> without redesigning this
 * structure. Only real, active profiles are ever published.
 */
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import MediaImg from '../../components/MediaImg.astro';
import { renderRichText } from '../../lib/richtext';
import { modeOf, stylistsPub } from '../../lib/pub';
import { getContent } from '../../lib/content';

const mode = modeOf(Astro);
const page = getContent<any>('page:hairstylists', mode);
const stylists = stylistsPub(mode);
if (!page) Astro.response.status = 404;
const single = stylists.length === 1 ? stylists[0] : null;
---

{page && (
  <Base title={page.seo.title} description={page.seo.description} editId="page:hairstylists">
    <PageHead
      eyebrow={page.eyebrow}
      title={page.heading}
      lede={page.lede}
      crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }, { label: page.heading }]}
    />

    <div class="wrap section">
      {single ? (
        <div class="split" style="align-items: start;">
          <div>
            <div class="photo-frame" style="aspect-ratio: 4 / 5;">
              <MediaImg mediaId={single.portrait} sizes="(max-width: 767px) 100vw, 45vw" loading="eager" />
            </div>
            <div class="note-box" style="margin-top: 20px;">
              <h4>Specialties</h4>
              <ul style="margin: 0; padding-left: 18px;">
                {(single.specialties ?? []).map((s: string) => <li>{s}</li>)}
              </ul>
              <p style="margin-top: 14px;">
                <a class="arrow-link" href={single.bookingHref ?? '/book'}>
                  Book an appointment
                  <svg class="arrow" width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" fill="none"><path d="M1 6h15M11.5 1.5 16.5 6l-5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </p>
            </div>
          </div>

          <article class="prose" id="my-story">
            <h2 style="margin-top: 0;">My Story</h2>
            {single.displayName && <p class="lede" style="margin-bottom: 1.4em;">{single.displayName} · {single.role}</p>}
            <div set:html={renderRichText(single.story)} />
            <p style="margin-top: 2em;">
              <a class="arrow-link" href="/about/philosophy">
                What that means for your appointment: the MC Philosophy
                <svg class="arrow" width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" fill="none"><path d="M1 6h15M11.5 1.5 16.5 6l-5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </p>
          </article>
        </div>
      ) : (
        <div class="card-grid">
          {stylists.map((s: any) => (
            <a class="tile-link" href={`/about/hairstylists/${s.slug}`}>
              <span class="photo-frame"><MediaImg mediaId={s.portrait} sizes="(max-width: 599px) 100vw, 33vw" /></span>
              <h3>{s.displayName || 'Hairstylist'}</h3>
              <p>{s.role}</p>
            </a>
          ))}
        </div>
      )}
    </div>
  </Base>
)}
