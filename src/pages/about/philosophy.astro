---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Sections from '../../components/Sections.astro';
import MediaImg from '../../components/MediaImg.astro';
import { renderRichText } from '../../lib/richtext';
import { modeOf } from '../../lib/pub';
import { getContent } from '../../lib/content';

const mode = modeOf(Astro);
const page = getContent<any>('page:philosophy', mode);
if (!page) Astro.response.status = 404;
---

{page && (
  <Base title={page.seo.title} description={page.seo.description} editId="page:philosophy">
    <PageHead
      eyebrow={page.eyebrow}
      title={page.heading}
      lede={page.lede}
      crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }, { label: page.heading }]}
    />

    <div class="wrap section">
      <div class="split" style="align-items: start;">
        <article class="prose">
          <Sections sections={page.sections} />
        </article>
        <div>
          {page.aside?.media && (
            <div class="photo-frame" style="aspect-ratio: 4 / 5;">
              <MediaImg mediaId={page.aside.media} sizes="(max-width: 767px) 100vw, 45vw" />
            </div>
          )}
          {page.aside?.noteTitle && (
            <div class="note-box" style="margin-top: 20px;">
              <h4>{page.aside.noteTitle}</h4>
              <div set:html={renderRichText(page.aside.noteText)} />
            </div>
          )}
        </div>
      </div>
    </div>
  </Base>
)}
