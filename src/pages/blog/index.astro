---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';

/* No articles are published yet; no posts are fabricated. Planned topics
   below come from the preserved MC material. */
const topics = ['Grey hair', 'Hair recovery', 'Self-care', 'Care homes'];
---

<Base
  title="Blog"
  description="Notes from Maison Coiffure on grey hair, hair recovery, self-care and care for care-home residents. Articles will appear here as they are written."
>
  <PageHead
    eyebrow="Blog"
    title="Notes from the salon"
    lede="Articles will appear here as they are written: honest, practical pieces at the same unhurried pace as the salon itself."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
  />

  <div class="wrap section">
    <div class="note-box" style="max-width: 62ch;">
      <h4>On the writing table</h4>
      <p>
        {topics.join(' · ')}
      </p>
      <p style="margin-top: 10px;">
        In the meantime, the <a href="/treatments">treatments catalogue</a> and the
        <a href="/about/philosophy">MC Philosophy</a> answer most questions, and
        <a href="/contact">a message</a> answers the rest.
      </p>
    </div>
  </div>
</Base>
