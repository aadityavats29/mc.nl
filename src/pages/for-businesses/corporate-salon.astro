---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Picture from '../../components/Picture.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { images } from '../../data/images';
---

<Base
  title="Corporate Salon"
  description="Bring Maison Coiffure to your workplace, coworking space or organisation for a tailored salon day of haircuts, treatments and personal care. Request a quote."
>
  <PageHead
    eyebrow="For Businesses"
    title="Corporate Salon"
    lede="Bring Maison Coiffure to your workplace or organisation for a tailored day of haircuts, treatments and personal care."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'For Businesses' }, { label: 'Corporate Salon' }]}
  />

  <div class="wrap section">
    <div class="split" style="align-items: start;">
      <article class="prose">
        <p>
          We create the programme around your location, group size and available time. A coworking
          space can offer its members a salon day; a larger company can book the salon as a
          workplace treat, a wellbeing day or part of an event.
        </p>
        <p>
          The programme can draw on the full <a href="/treatments">Maison Coiffure catalogue</a>:
          haircuts, styling, nourishing treatments and Indian head massages, delivered with the same
          calm and personal attention as in the salon. Half-day visits and recurring arrangements
          can be discussed.
        </p>
        <p>
          Every corporate enquiry is quoted personally. Tell us about your organisation, location
          and group, and we will design a day that fits.
        </p>
      </article>
      <div class="photo-frame" style="aspect-ratio: 4 / 5;">
        <Picture image={images.haircutShort} sizes="(max-width: 767px) 100vw, 45vw" />
      </div>
    </div>

    <hr style="margin-block: 48px;" />
    <EnquiryForm requestType="Organisation" heading="Request a corporate salon quote" />
  </div>
</Base>
