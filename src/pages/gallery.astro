---
/* Real Maison Coiffure work from the shared media registry. No before/after
   pairings are claimed: pairing and permissions await owner confirmation. */
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import MediaImg from '../components/MediaImg.astro';
import { renderRichText } from '../lib/richtext';
import { modeOf } from '../lib/pub';
import { getContent } from '../lib/content';

const mode = modeOf(Astro);
const page = getContent<any>('page:gallery', mode);
if (!page) Astro.response.status = 404;
---

{page && (
  <Base title={page.seo.title} description={page.seo.description} editId="page:gallery">
    <PageHead
      eyebrow={page.eyebrow}
      title={page.heading}
      lede={page.lede}
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Gallery' }]}
    />

    <div class="wrap section">
      <div class="gallery-grid">
        {(page.media ?? []).map((id: string) => (
          <figure>
            <span class="photo-frame">
              <MediaImg mediaId={id} sizes="(max-width: 479px) 100vw, (max-width: 899px) 50vw, 33vw" />
            </span>
          </figure>
        ))}
      </div>
      {page.note && <div class="note-box" style="margin-top: 40px; max-width: 62ch;" set:html={renderRichText(page.note)} />}
    </div>
  </Base>
)}
