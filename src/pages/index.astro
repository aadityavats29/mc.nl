---
/**
 * Homepage per the 14 September 2026 Navy-led update. Every section reads
 * from the published homepage record (page:home) and the shared catalogue,
 * brand and media records, so Studio edits appear here on publish.
 */
import Base from '../layouts/Base.astro';
import Monogram from '../components/Monogram.astro';
import MediaImg from '../components/MediaImg.astro';
import TreatmentExplorer from '../components/TreatmentExplorer.astro';
import AboutCards from '../components/AboutCards.astro';
import BrandStrip from '../components/BrandStrip.astro';
import { renderRichText } from '../lib/richtext';
import { modeOf, sitePub, treatmentsPub, brandsPub, waLinkFor } from '../lib/pub';
import { getContent } from '../lib/content';
import { getMedia, mediaSrcset, mediaUrl } from '../lib/content';

const mode = modeOf(Astro);
const page = getContent<any>('page:home', mode);
if (!page) return new Response('Not published', { status: 404 });
const site = sitePub(mode);
const rows = treatmentsPub(mode);
const brands = brandsPub(mode);
const heroDesktop = getMedia(page.hero?.mediaDesktop);
const heroMobile = getMedia(page.hero?.mediaMobile);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: site.name,
  url: site.url,
  telephone: site.phoneIntl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.streetAddress,
    addressLocality: site.locality,
    addressCountry: 'NL',
  },
  sameAs: [site.instagram],
  description: page.seo.description,
};
---

<Base title={page.seo.title} description={page.seo.description} page="home" jsonLd={jsonLd} editId="page:home">
  <!-- 1 · Logo landing over the landscape hero -->
  {page.hero?.visible && heroDesktop && (
    <section class="hero-landing" aria-label="Welcome">
      <picture>
        {heroMobile && <source media="(max-width: 767px)" srcset={mediaSrcset(heroMobile)} sizes="100vw" />}
        <img
          class="hero-landing-img"
          src={mediaUrl(heroDesktop, 1800)}
          srcset={mediaSrcset(heroDesktop)}
          sizes="100vw"
          alt={heroDesktop.alt}
          width={heroDesktop.w}
          height={heroDesktop.h}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          style={`--hero-focus-x: ${heroDesktop.focal_x}%; --hero-focus-y: ${heroDesktop.focal_y}%;`}
        />
      </picture>
      <div class="hero-landing-scrim" aria-hidden="true"></div>
      <div class="hero-landing-content">
        <div class="hero-mark"><Monogram /></div>
        <div class="hero-text">
          <a class="btn btn-on-image hero-book" href={page.hero.bookingHref}>{page.hero.bookingLabel}</a>
        </div>
      </div>
    </section>
  )}

  <!-- 2 · Spacious introduction -->
  {page.intro?.visible && (
    <section class="section-lg intro-section" aria-labelledby="intro-h">
      {page.intro.watermark && <div class="intro-watermark" aria-hidden="true"><Monogram label="" /></div>}
      <div class="wrap intro-inner">
        <h1 id="intro-h" class="intro-heading reveal-intro" data-intro="h">{page.intro.heading}</h1>
        <div class="intro-copy reveal-intro" data-intro="c">
          <div set:html={renderRichText(page.intro.body)} />
          {page.intro.tagline && <p class="intro-tagline">{page.intro.tagline}</p>}
          <div class="hero-actions" style="justify-content: center;">
            {page.intro.primaryCta?.label && <a class="btn btn-primary" href={page.intro.primaryCta.href}>{page.intro.primaryCta.label}</a>}
            {page.intro.secondaryCta?.label && <a class="btn btn-quiet" href={page.intro.secondaryCta.href}>{page.intro.secondaryCta.label}</a>}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 3 · Animated About cards -->
  {page.aboutCards?.visible && <AboutCards data={page.aboutCards} />}

  <!-- 4 · Brand marquee -->
  {page.brands?.visible && <BrandStrip data={page.brands} brands={brands} />}

  <!-- 5 · Treatments explorer with retained hover previews -->
  {page.explorer?.visible && (
    <section class="section-lg section-surface">
      <div class="wrap">
        <div class="reveal" style="max-width: 62ch; margin-bottom: 44px;">
          <span class="eyebrow">Treatments</span>
          <h2>{page.explorer.heading}</h2>
          <p class="lede">{page.explorer.lede}</p>
        </div>
        <div class="reveal">
          <TreatmentExplorer rows={rows} idPrefix="home" />
        </div>
        <p class="reveal" style="margin-top: 36px;">
          <a class="arrow-link" href="/treatments">
            {page.explorer.footerLink}
            <svg class="arrow" width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" fill="none"><path d="M1 6h15M11.5 1.5 16.5 6l-5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </p>
      </div>
    </section>
  )}

  <!-- 6 · Salon Party -->
  {page.salonParty?.visible && (
    <section class="section-lg">
      <div class="wrap split">
        <a class="photo-frame split-media" href={page.salonParty.href} tabindex="-1" aria-hidden="true">
          <MediaImg mediaId={page.salonParty.media} sizes="(max-width: 767px) 100vw, 45vw" />
        </a>
        <div class="reveal">
          <span class="eyebrow">Salon Party</span>
          <h2>{page.salonParty.heading}</h2>
          <div set:html={renderRichText(page.salonParty.body)} />
          <a class="btn btn-primary" href={page.salonParty.href} style="margin-top: 20px;">{page.salonParty.cta}</a>
        </div>
      </div>
    </section>
  )}

  <!-- 7 · Real work -->
  {page.recentWork?.visible && (
    <section class="section-lg section-surface">
      <div class="wrap">
        <div class="reveal" style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 36px;">
          <h2 style="margin: 0;">{page.recentWork.heading}</h2>
          <a class="arrow-link" href="/gallery">
            Browse the gallery
            <svg class="arrow" width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" fill="none"><path d="M1 6h15M11.5 1.5 16.5 6l-5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <div class="card-grid">
          {(page.recentWork.media ?? []).map((id: string, i: number) => (
            <a class="tile-link reveal" href="/gallery" data-reveal-group="work" data-reveal-index={i}>
              <span class="photo-frame" style="aspect-ratio: 4 / 5;"><MediaImg mediaId={id} sizes="(max-width: 599px) 100vw, (max-width: 1023px) 50vw, 33vw" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 8 · Practical contact and booking -->
  {page.practical?.visible && (
    <section class="section-lg">
      <div class="wrap split">
        <div class="reveal">
          <span class="eyebrow">Visit or invite us</span>
          <h2>{page.practical.heading}</h2>
          <div set:html={renderRichText(page.practical.body)} />
          <div class="hero-actions" style="margin-top: 18px;">
            <a class="btn btn-primary" href={waLinkFor(site, 'Hello Maison Coiffure, I would like to make an appointment.')} rel="noopener">WhatsApp for an appointment</a>
            <a class="btn btn-quiet" href="/contact">Contact details</a>
          </div>
        </div>
        <div class="reveal">
          <h3 style="font-family: var(--font-body); font-size: 0.8125rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); font-weight: 700;">For businesses</h3>
          <ul class="explorer" style="margin-top: 10px;">
            <li>
              <a class="explorer-link" href="/for-businesses/corporate-salon">
                <span class="explorer-name">Corporate Salon</span>
                <svg class="arrow" width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" fill="none"><path d="M1 6h15M11.5 1.5 16.5 6l-5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="explorer-sum">A tailored salon day at your workplace or coworking space.</span>
              </a>
            </li>
            <li>
              <a class="explorer-link" href="/for-businesses/care-homes">
                <span class="explorer-name">Care Homes</span>
                <svg class="arrow" width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" fill="none"><path d="M1 6h15M11.5 1.5 16.5 6l-5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="explorer-sum">Gentle, personal care for residents in familiar surroundings.</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  )}
</Base>
